{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aianimationstudio.local/schema/m57/scene-ir-v1.schema.json",
  "title": "AI Animation Studio M57 Scene IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scene_ir_version",
    "source",
    "project_id",
    "scene_id",
    "entities",
    "shots",
    "output",
    "required_capabilities",
    "warnings",
    "unresolved_terms"
  ],
  "properties": {
    "scene_ir_version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "original_text", "normalized_text", "script_sha256", "build_sha", "reference_sha256", "provider", "model", "request_id"],
      "properties": {
        "language": { "enum": ["ARMENIAN", "ENGLISH", "RUSSIAN", "MIXED"] },
        "original_text": { "type": "string", "minLength": 1, "maxLength": 24576 },
        "normalized_text": { "type": "string", "minLength": 1, "maxLength": 24576 },
        "script_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "build_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "reference_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "project_id": { "$ref": "#/$defs/stableId" },
    "scene_id": { "$ref": "#/$defs/stableId" },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/entity" }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/shot" }
    },
    "output": { "$ref": "#/$defs/output" },
    "continuity": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/continuity" },
      "default": []
    },
    "lighting": { "$ref": "#/$defs/lighting" },
    "environment": { "$ref": "#/$defs/environment" },
    "required_capabilities": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 96 }
    },
    "warnings": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 512 }
    },
    "unresolved_terms": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_excerpt", "reason"],
        "properties": {
          "source_excerpt": { "type": "string", "minLength": 1, "maxLength": 512 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source_bound"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "enum": ["ACTOR", "OBJECT", "LOCATION"] },
        "source_bound": { "type": "boolean" },
        "aliases": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 128 }
        },
        "material": { "type": ["string", "null"], "maxLength": 128 },
        "color": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start_seconds", "duration_seconds", "camera", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "start_seconds": { "type": "number", "minimum": 0, "maximum": 3600 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
        "camera": { "$ref": "#/$defs/camera" },
        "actions": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_size", "angle", "movement", "focus_target_id"],
      "properties": {
        "shot_size": { "enum": ["EXTREME_CLOSE_UP", "CLOSE_UP", "MEDIUM", "FULL", "WIDE"] },
        "angle": { "enum": ["EYE_LEVEL", "HIGH", "LOW", "TOP_DOWN"] },
        "movement": { "enum": ["LOCKED", "PAN", "TILT", "DOLLY", "TRACK", "ZOOM"] },
        "focus_target_id": { "$ref": "#/$defs/stableId" },
        "lens_mm": { "type": ["number", "null"], "minimum": 8, "maximum": 600 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "concept", "actor_id", "source_excerpt", "required_capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "concept": {
          "enum": ["WAIT", "SPEAK", "REACT", "SIT", "STAND", "WALK_TO", "RUN_TO", "LOOK_AT", "PICK_UP", "OPEN", "CLOSE", "CAMERA_MOVE", "LIGHTING_CHANGE", "ENVIRONMENT_CHANGE"]
        },
        "actor_id": { "$ref": "#/$defs/stableId" },
        "target_id": { "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] },
        "start_seconds": { "type": ["number", "null"], "minimum": 0, "maximum": 3600 },
        "duration_seconds": { "type": ["number", "null"], "minimum": 0, "maximum": 3600 },
        "emotion": { "type": ["string", "null"], "maxLength": 128 },
        "expression": { "type": ["string", "null"], "maxLength": 128 },
        "pose": { "type": ["string", "null"], "maxLength": 128 },
        "gesture": { "type": ["string", "null"], "maxLength": 128 },
        "spatial_relation": { "type": ["string", "null"], "maxLength": 256 },
        "dialogue": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "intent"],
              "properties": {
                "text": { "type": "string", "maxLength": 8192 },
                "intent": { "type": "string", "maxLength": 256 },
                "narration": { "type": "boolean", "default": false }
              }
            }
          ]
        },
        "source_excerpt": { "type": "string", "minLength": 1, "maxLength": 512 },
        "required_capabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 96 }
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "rule"],
      "properties": {
        "entity_id": { "$ref": "#/$defs/stableId" },
        "rule": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent": { "type": ["string", "null"], "maxLength": 256 },
        "time_of_day": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "location_intent": { "type": ["string", "null"], "maxLength": 256 },
        "weather": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "duration_seconds"],
      "properties": {
        "width": { "type": "integer", "minimum": 64, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 64, "maximum": 8192 },
        "fps": { "type": "number", "minimum": 1, "maximum": 120 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
        "aspect": { "type": ["string", "null"], "maxLength": 32 }
      }
    }
  }
}
