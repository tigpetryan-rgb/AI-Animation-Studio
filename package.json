{
  "name": "ai-animation-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:foundation",
    "build:foundation": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "legacy:web:build": "vite build apps/studio-web",
    "legacy:web:preview": "vite preview apps/studio-web --host 127.0.0.1 --port 4173",
    "legacy:web:test:browser": "playwright test",
    "legacy:web:manifest": "AISTUDIO_ALLOW_LEGACY_WEB_PACKAGE=1 node scripts/create-release-manifest.mjs",
    "legacy:web:package": "npm run legacy:web:build && npm run legacy:web:manifest && AISTUDIO_ALLOW_LEGACY_WEB_PACKAGE=1 bash scripts/package-release-candidate.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
